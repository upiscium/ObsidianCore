{
  "schema_version": 1,
  "required_plugins": [
    "templater-obsidian",
    "quickadd"
  ],
  "templater": {
    "templates_folder": "98-System/03-template",
    "user_scripts_folder": "98-System/01-script"
  },
  "quickadd": {
    "required_choices": [
      {
        "name": "Task: Create",
        "script": "98-System/01-script/create_task.js"
      },
      {
        "name": "Task: Quick",
        "script": "98-System/01-script/quick_task.js"
      },
      {
        "name": "System: Validate Vault",
        "script": "98-System/01-script/validate_vault.js"
      }
    ],
    "distribution": {
      "method": "official-package-export-import",
      "note": "Export these choices from Settings > QuickAdd > Export package and commit the resulting .quickadd.json after reviewing it. Do not commit .obsidian/plugins/quickadd/data.json."
    }
  }
}
