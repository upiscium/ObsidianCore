{
  "schema_version": 1,
  "required_plugins": [
    "templater-obsidian",
    "quickadd"
  ],
  "templater": {
    "templates_folder": "98-System/03-template",
    "user_scripts_folder": "98-System/01-script",
    "startup_templates": [
      {
        "template": "98-System/03-template/99-startup/startup-desktop.md",
        "required": true,
        "profile": "desktop",
        "purpose": "Device-guarded desktop startup: CSS, Daily/Monthly, Recurring Tasks"
      },
      {
        "template": "98-System/03-template/99-startup/startup-mobile.md",
        "required": true,
        "profile": "mobile",
        "purpose": "Device-guarded mobile startup: CSS, Daily/Monthly, Recurring Tasks and due Subscription posting"
      },
      {
        "template": "98-System/03-template/99-startup/create_periodic_note.md",
        "required": false,
        "profile": "legacy",
        "purpose": "Backward-compatible Templater wrapper; unregister on both device profiles"
      },
      {
        "template": "98-System/03-template/99-startup/generate-recurring-tasks.md",
        "required": false,
        "profile": "legacy",
        "purpose": "Backward-compatible Templater wrapper; unregister on both device profiles"
      }
    ],
    "startup_configuration": {
      "enable_startup_templates": true,
      "registration": "manual-once-per-device-profile",
      "profiles": {
        "desktop": {
          "config_folder": ".obsidian",
          "templates": [
            "98-System/03-template/99-startup/startup-desktop.md"
          ],
          "subscription_writer": false
        },
        "mobile": {
          "config_folder": ".obsidian-mobile",
          "templates": [
            "98-System/03-template/99-startup/startup-mobile.md"
          ],
          "subscription_writer": true
        }
      },
      "subscription_writer_profile": "mobile",
      "fallback": "Dashboard button: sync-subscriptions; desktop may be designated sole writer only after disabling mobile startup writer",
      "migration": "remove legacy startup template registrations from both profiles; register exactly one profile-specific startup template on each device"
    }
  },
  "style_distribution": {
    "source": "98-System/90-config/styles/obsidian-core.css",
    "target": "<vault.configDir>/snippets/obsidian-core.css",
    "responsive_source": "98-System/90-config/styles/obsidian-core-mobile.css",
    "responsive_target": "<vault.configDir>/snippets/obsidian-core-mobile.css",
    "installer_script": "98-System/01-script/sync_core_style.js",
    "activation": "startup-managed-canonical-with-shared-config",
    "config_sync_role": "optional-redundant-path",
    "appearance_target": "<vault.configDir>/appearance.json",
    "canonical_snippets": [
      "obsidian-core",
      "obsidian-core-mobile"
    ],
    "legacy_managed_snippets": [
      "callout-colors",
      "expense-dashboard-lite",
      "mobile-home-buttons",
      "monthly-expanse",
      "task-button",
      "task-controls",
      "task-status",
      "work-time"
    ],
    "unrelated_snippets": "preserve"
  },
  "quickadd": {
    "required_choices": [
      {
        "name": "Task: Create",
        "script": "98-System/01-script/create_task.js"
      },
      {
        "name": "Task: Quick",
        "script": "98-System/01-script/quick_task.js"
      },
      {
        "name": "Task: Backlog",
        "script": "98-System/01-script/backlog_task.js"
      },
      {
        "name": "Work: Add",
        "script": "98-System/01-script/add_work.js"
      },
      {
        "name": "System: Validate Vault",
        "script": "98-System/01-script/validate_vault.js"
      }
    ],
    "distribution": {
      "method": "official-package-export-import",
      "note": "Export required choices from QuickAdd and review the generated package before committing it. Do not commit .obsidian/plugins/quickadd/data.json."
    }
  }
}
